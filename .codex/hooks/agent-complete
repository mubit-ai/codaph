#!/usr/bin/env bash
set -euo pipefail

# >>> codaph sync >>>
if command -v codaph >/dev/null 2>&1; then
  codaph hooks run agent-complete --provider 'codex' --quiet
elif command -v bun >/dev/null 2>&1; then
  bun run --cwd '/opt/homebrew/lib/node_modules/@codaph/codaph' cli hooks run agent-complete --provider 'codex' --quiet
fi
# <<< codaph sync <<<
